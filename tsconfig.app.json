{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "./src/**/*",
    "./forge.env.d.ts",
    "./autoImports.d.ts",
    "./components.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "outDir": "./node_modules/.tmp",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "jsx": "preserve",
    "baseUrl": ".",
    "noImplicitAny": false,
    "esModuleInterop": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "unplugin-icons/types/vue"
    ]
  }
}